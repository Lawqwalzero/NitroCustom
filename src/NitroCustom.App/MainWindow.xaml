<Window x:Class="NitroCustom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NitroCustom.App"
        Title="NitroCustom" Width="1140" Height="580"
        WindowStyle="None" ResizeMode="CanMinimize" ShowInTaskbar="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Body}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ================= Main area ================= -->
            <Grid Background="{StaticResource WindowBg}" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Perspective floor lines, very faint -->
                <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.18">
                    <Line X1="-40" Y1="560" X2="330" Y2="330" Stroke="#FF6A1F" StrokeThickness="1" />
                    <Line X1="860" Y1="560" X2="490" Y2="330" Stroke="#FF6A1F" StrokeThickness="1" />
                    <Line X1="120" Y1="580" X2="370" Y2="330" Stroke="#FF6A1F" StrokeThickness="0.6" />
                    <Line X1="700" Y1="580" X2="450" Y2="330" Stroke="#FF6A1F" StrokeThickness="0.6" />
                    <Line X1="0" Y1="470" X2="820" Y2="470" Stroke="#FF6A1F" StrokeThickness="0.6" />
                    <Line X1="0" Y1="520" X2="820" Y2="520" Stroke="#FF6A1F" StrokeThickness="0.6" />
                </Canvas>

                <!-- Title -->
                <Grid x:Name="TitleBar" Height="44" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Bahnschrift SemiBold" FontSize="24">
                        <TextBlock.RenderTransform><SkewTransform AngleX="-8" /></TextBlock.RenderTransform>
                        <Run Text="NITRO" Foreground="#F0282A" /><Run Text="CUSTOM" Foreground="#FF7A1F" />
                    </TextBlock>
                </Grid>

                <!-- System mode -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-2,0,0">
                    <TextBlock Text="{local:Tr 'Режим системы', 'System mode'}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ModeName" Text="—" FontFamily="{StaticResource Display}" FontSize="19" HorizontalAlignment="Center" Margin="0,1,0,0">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="ModeNameShift" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <Grid Width="220" Height="6" Margin="0,6,0,0" ClipToBounds="True">
                        <Grid.OpacityMask>
                            <VisualBrush TileMode="Tile" Viewport="0,0,8,6" ViewportUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Path Data="M0,6 L3,0 L6,0 L3,6 Z" Fill="Black" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>
                        <Border Background="#5A2A16" />
                        <!-- Ember sweep across the stripes on every mode change -->
                        <Border x:Name="Sweep" Width="90" HorizontalAlignment="Left" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFB21F" Offset="0" />
                                    <GradientStop Color="#FFFFB21F" Offset="0.5" />
                                    <GradientStop Color="#00FF5A1F" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform><TranslateTransform x:Name="SweepShift" X="-90" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Status (only when something is wrong) -->
                <Border x:Name="StatusBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Background="#CC2A0E08" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="14,7" Visibility="Collapsed" Panel.ZIndex="10">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" TextWrapping="Wrap" MaxWidth="520" />
                </Border>

                <Grid Grid.Row="2" Margin="40,10,40,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: fans and load -->
                    <local:ChamferFrame Padding="18,14,18,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{local:Tr 'Вентиляторы', 'Fans'}" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{StaticResource Muted}" />
                            <StackPanel DockPanel.Dock="Bottom">
                                <local:LoadBar x:Name="CpuLoad" Caption="{local:Tr 'Загрузка CPU', 'CPU load'}" Height="30" Margin="0,0,0,8" />
                                <local:LoadBar x:Name="RamLoad" Caption="{local:Tr 'Память', 'Memory'}" Height="30" />
                            </StackPanel>
                            <UniformGrid Rows="1" Margin="0,10,0,10" VerticalAlignment="Center">
                                <StackPanel>
                                    <local:ArcGauge x:Name="CpuFanGauge" Width="100" Height="100" Maximum="6000" Unit="{local:Tr 'об/мин', 'rpm'}" />
                                    <TextBlock Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <local:ArcGauge x:Name="GpuFanGauge" Width="100" Height="100" Maximum="6000" Unit="{local:Tr 'об/мин', 'rpm'}" />
                                    <TextBlock Text="GPU" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                    </local:ChamferFrame>

                    <!-- Centre: emblem -->
                    <Viewbox Grid.Column="1" Margin="30,10,30,0" MaxHeight="300" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><ScaleTransform x:Name="EmblemScale" /></Viewbox.RenderTransform>
                        <Canvas Width="104" Height="102">
                            <Canvas.Effect>
                                <DropShadowEffect x:Name="EmblemGlow" Color="#FF4A12" BlurRadius="40" ShadowDepth="0" Opacity="0.45" />
                            </Canvas.Effect>
                            <Path Data="M12,96 L24,4 L42,20 L64,62 L70,18 L90,4 L80,96 L62,82 L38,40 L30,86 Z" Fill="#6E0E06">
                                <Path.RenderTransform><TranslateTransform X="5" Y="3" /></Path.RenderTransform>
                            </Path>
                            <Path Data="M12,96 L24,4 L42,20 L64,62 L70,18 L90,4 L80,96 L62,82 L38,40 L30,86 Z" Stroke="#FFE29A" StrokeThickness="0.6" StrokeLineJoin="Miter">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFC22A" Offset="0" />
                                        <GradientStop Color="#FF6A12" Offset="0.5" />
                                        <GradientStop Color="#E31E24" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Canvas>
                    </Viewbox>

                    <!-- Right: temperatures -->
                    <local:ChamferFrame Grid.Column="2" Padding="18,14,18,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{local:Tr 'Температура', 'Temperature'}" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{StaticResource Muted}" />
                            <UniformGrid Columns="1" Margin="0,6,0,0">
                                <DockPanel>
                                    <local:ArcGauge x:Name="GpuTempGauge" Width="92" Height="92" Maximum="100" Unit="°C" />
                                    <TextBlock Text="GPU" FontFamily="{StaticResource Display}" FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </DockPanel>
                                <DockPanel>
                                    <local:ArcGauge x:Name="CpuTempGauge" Width="92" Height="92" Maximum="100" Unit="°C" />
                                    <TextBlock Text="CPU" FontFamily="{StaticResource Display}" FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </DockPanel>
                                <DockPanel>
                                    <local:ArcGauge x:Name="SysTempGauge" Width="92" Height="92" Maximum="100" Unit="°C" />
                                    <TextBlock Text="{local:Tr 'Система', 'System'}" FontFamily="{StaticResource Display}" FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </DockPanel>
                            </UniformGrid>
                        </DockPanel>
                    </local:ChamferFrame>
                </Grid>
            </Grid>

            <!-- ================= Sidebar ================= -->
            <Border Grid.Column="1" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Window buttons -->
                    <Grid DockPanel.Dock="Top" Height="38" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="{local:Tr 'Управление', 'Control'}" FontFamily="{StaticResource Display}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Quiet}" Width="44" Height="38" Click="Hide_Click" ToolTip="{local:Tr 'Свернуть в трей', 'Minimize to tray'}">
                                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Button>
                            <Button Style="{StaticResource CloseButton}" Width="44" Height="38" Click="Hide_Click" ToolTip="{local:Tr 'Закрыть в трей', 'Close to tray'}">
                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="10,0,10,0">
                        <!-- Profiles: a highlight bar slides behind the rows -->
                        <ContentControl Style="{StaticResource SidebarHeader}" Content="{local:Tr 'Режим', 'Mode'}" local:Glyph.Data="{StaticResource IconModes}" />
                        <Grid Margin="0,6,0,14">
                            <Border x:Name="ProfileHighlight" Height="36" VerticalAlignment="Top" Background="{StaticResource AccentGrad}" CornerRadius="3" Opacity="0">
                                <Border.RenderTransform><TranslateTransform x:Name="HighlightShift" /></Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="ProfilePanel" />
                        </Grid>

                        <!-- Lighting -->
                        <ContentControl Style="{StaticResource SidebarHeader}" Content="{local:Tr 'Подсветка клавиатуры', 'Keyboard lighting'}" local:Glyph.Data="{StaticResource IconLighting}" />
                        <StackPanel x:Name="LightingPanel" Margin="12,12,12,0">
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="LightOn" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                          Checked="Lighting_Changed" Unchecked="Lighting_Changed" ToolTip="{local:Tr 'Подсветка вкл/выкл', 'Lighting on/off'}" />
                                <ComboBox x:Name="EffectBox" SelectionChanged="Lighting_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon}" Data="{Binding Icon}" Stroke="{StaticResource Accent}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <!-- Keyboard preview: 4 zones, click a zone to colour it in Direct mode -->
                            <Grid x:Name="Preview" Height="26" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <StackPanel x:Name="ColorRow" Margin="0,0,0,10">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBox x:Name="HexBox" DockPanel.Dock="Right" Width="72" MaxLength="7" LostKeyboardFocus="HexBox_Commit" KeyDown="HexBox_KeyDown" ToolTip="Свой цвет #RRGGBB" />
                                    <TextBlock x:Name="ColorLabel" Text="{local:Tr 'Цвет', 'Colour'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" />
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" /><ColumnDefinition /><ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Tr 'Яркость', 'Brightness'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="Slider_Changed" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}}" FontFamily="Bahnschrift SemiBold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid x:Name="SpeedRow" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" /><ColumnDefinition /><ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Tr 'Скорость', 'Speed'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="1" Maximum="9" TickFrequency="1" ValueChanged="Slider_Changed" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0}}" FontFamily="Bahnschrift SemiBold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid x:Name="DirectionRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Tr 'Направление', 'Direction'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="{StaticResource Radius}" Padding="2">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="DirLeft" Style="{StaticResource Segment}" GroupName="Dir" Content="{local:Tr '← влево', '← left'}" Checked="Lighting_Changed" />
                                        <RadioButton x:Name="DirRight" Style="{StaticResource Segment}" GroupName="Dir" Content="{local:Tr 'вправо →', 'right →'}" Checked="Lighting_Changed" />
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
